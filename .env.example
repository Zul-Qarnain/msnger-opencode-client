# --- Direct Facebook app mode (your own Meta app, no OnlyOrders) ---
# Set FB_PAGE_TOKEN and the server talks to Meta directly:
# incoming Meta webhooks on /webhook, replies via graph.facebook.com.
FB_PAGE_TOKEN=
# App Secret (Meta dashboard → App settings → Basic → App Secret). Used to
# verify X-Hub-Signature-256 on incoming webhooks. Optional but recommended.
FB_APP_SECRET=
# Verify token YOU invent (any random string). Pasted into Meta's webhook
# setup; Meta sends it back on verify and the server checks it.
FB_VERIFY_TOKEN=msgctrl-verify
# Page ID the bot controls (Meta dashboard → Messenger → Page). Optional;
# incoming events already carry it.
FB_PAGE_ID=

# --- Legacy OnlyOrders mode (leave blank when using FB_* above) ---
# OnlyOrders external-service API base (api2 or the web /api proxy both work)
ONLYORDERS_API_BASE=https://onlyorders.tech/api2/ext-service

# Optional: reuse an existing external service (one that already has a connected
# Facebook channel). Leave blank to have the server create a new service on boot.
ONLYORDERS_SERVICE_ID=

# Public webhook URL that OnlyOrders should POST to. Set this to the Cloudflare
# quick-tunnel URL once the tunnel is up, then restart or call /register again.
PUBLIC_WEBHOOK_URL=

# Optional: restrict the bot to your own sender IDs (comma-separated).
# Your Page-scoped sender ID is logged on first contact; strangers are
# dropped silently when this is set.
OWNER_PSIDS=

# Optional: voice notes → Deepgram Nova-3 transcript → OpenCode prompt.
# Get a key at https://console.deepgram.com (free tier available).
DEEPGRAM_API_KEY=
# Optional overrides (defaults shown).
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# HTTP port for the local webhook receiver
PORT=8788

# Default directory used by !commands and /session new when no path is given
DEFAULT_DIRECTORY=/home/ubuntu/Oryxa

# Optional default model for newly created sessions (providerID/modelID).
# Overrides the random default so you can pin a model with working credentials.
OPENCODE_MODEL=opencode/hy4-flash-free
# Optional effort variant for the model (e.g. low, medium, high, xhigh, max
# where the model supports variants). Applied to new and switched sessions.
# OPENCODE_MODEL_VARIANT=xhigh
